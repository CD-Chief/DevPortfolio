---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { slugify } from '../../utils/slug';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return posts.map((post) => ({
    params: { slug: post.data.slug ?? slugify(post.data.title) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('posts');
const allProjects = await getCollection('projects');

const relatedPostSlugs = post.data.relatedPosts ?? [];
const relatedPosts = relatedPostSlugs
  .map((slug) => allPosts.find((p) => (p.data.slug ?? slugify(p.data.title)) === slug))
  .filter((relatedPost): relatedPost is (typeof allPosts)[number] => Boolean(relatedPost));

const relatedProjectIds = post.data.relatedProjects ?? [];
const relatedProjects = allProjects.filter((project) => relatedProjectIds.includes(project.data.id));
---

<Layout>
  <section class="min-h-screen w-full flex items-center justify-center p-4 bg-Background1">
    <div class="w-full max-w-5xl h-auto min-h-[90vh] rounded-2xl p-4 sm:p-6 md:p-12 shadow-lg bg-Background2">
      <div class="flex items-center justify-between mb-8">
        <a
          href="/blog"
          class="px-6 py-2 rounded-lg font-Display2 font-medium transition-all duration-300 bg-Primary2 text-white hover:-translate-y-0.5 hover:shadow-xl hover:opacity-90"
        >
          All Posts
        </a>
        <div class="w-[100px]"></div>
      </div>

      <header class="mb-8">
        <h1 class="text-4xl font-Display1 text-Neutral-Dark mb-4">{post.data.title}</h1>
        <div class="text-sm text-gray-500 mb-4">Published {post.data.publishedAt}</div>
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="px-3 py-1 rounded-full text-xs font-medium border bg-gray-100 text-gray-700 border-gray-300">
              {tag}
            </span>
          ))}
        </div>
      </header>

      <div class="mb-8 rounded-xl border border-gray-200">
        <Image
          src={post.data.coverImage}
          alt={post.data.title}
          width={post.data.coverImage.width}
          height={post.data.coverImage.height}
          sizes="(max-width: 768px) 100vw, 800px"
          class="w-full h-auto object-contain rounded-xl"
        />
      </div>

      <div class="mb-10 text-gray-700">
        <p class="text-lg leading-relaxed">{post.data.excerpt}</p>
      </div>

      <article class="prose prose-lg max-w-none">
        <Content />
      </article>

      {post.data.links && post.data.links.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-Display1 text-Neutral-Dark mb-4">Links</h2>
          <div class="flex flex-wrap gap-3">
            {post.data.links.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 rounded-lg font-Display2 font-medium transition-all duration-300 bg-Primary2 text-white hover:-translate-y-0.5 hover:shadow-xl hover:opacity-90"
              >
                {link.label}
              </a>
            ))}
          </div>
        </section>
      )}

      {relatedPosts.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-Display1 text-Neutral-Dark mb-4">Related Posts</h2>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {relatedPosts.map((related) => (
              <li class="border border-gray-200 rounded-lg p-4 bg-white">
                <a
                  href={`/blog/${related.data.slug ?? slugify(related.data.title)}`}
                  class="font-Display2 text-Neutral-Dark hover:text-Primary1 transition-colors"
                >
                  {related.data.title}
                </a>
                <div class="text-xs text-gray-500 mt-1">{related.data.publishedAt}</div>
              </li>
            ))}
          </ul>
        </section>
      )}

      {relatedProjects.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-Display1 text-Neutral-Dark mb-4">Related Projects</h2>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {relatedProjects.map((project) => (
              <li class="border border-gray-200 rounded-lg p-4 bg-white">
                <a
                  href="/projects"
                  class="font-Display2 text-Neutral-Dark hover:text-Primary1 transition-colors"
                >
                  {project.data.title}
                </a>
                <div class="text-xs text-gray-500 mt-1">View on projects page</div>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </section>
</Layout>
