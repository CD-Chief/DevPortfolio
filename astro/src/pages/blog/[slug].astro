---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import TagList from '../../components/TagList.astro';
import { slugify } from '../../utils/slug';
import { formatDate } from '../../utils/date';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return posts.map((post) => ({
    params: { slug: post.data.slug ?? slugify(post.data.title) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('posts');
const allProjects = await getCollection('projects');

const relatedPostSlugs = post.data.relatedPosts ?? [];
const relatedPosts = relatedPostSlugs
  .map((slug) => allPosts.find((p) => (p.data.slug ?? slugify(p.data.title)) === slug))
  .filter((relatedPost): relatedPost is (typeof allPosts)[number] => Boolean(relatedPost));

const relatedProjectIds = post.data.relatedProjects ?? [];
const relatedProjects = allProjects.filter((project) => relatedProjectIds.includes(project.data.id));
---

<Layout title={`${post.data.title} | Chief-Daniel Osei`} description={post.data.excerpt} type="article">
  <article class="mx-auto max-w-3xl px-4 pb-10 pt-4 sm:px-8">
    <a href="/blog" class="link-arrow">← All posts</a>

    <header class="mb-8 mt-8 flex flex-col gap-4">
      <p class="eyebrow flex items-center gap-2">
        <span>{post.data.topic}</span>
        <span class="text-ink-muted" aria-hidden="true">·</span>
        <time datetime={post.data.publishedAt} class="text-ink-muted">{formatDate(post.data.publishedAt)}</time>
      </p>
      <h1 class="text-4xl font-semibold leading-tight tracking-tight text-ink sm:text-5xl">{post.data.title}</h1>
      <p class="text-lg leading-relaxed text-ink-muted">{post.data.excerpt}</p>
      <TagList tags={post.data.tech} />
    </header>

    <div class:list={['mb-10 overflow-hidden rounded-2xl border border-line', post.data.coverImage.format === 'svg' && 'cover-svg p-6']}>
      <Image
        src={post.data.coverImage}
        alt=""
        width={post.data.coverImage.width}
        height={post.data.coverImage.height}
        sizes="(max-width: 768px) 100vw, 768px"
        class="h-auto w-full object-contain"
      />
    </div>

    <div class="prose prose-lg prose-invert prose-site max-w-none">
      <Content />
    </div>

    {post.data.links && post.data.links.length > 0 && (
      <section class="mt-14">
        <h2 class="eyebrow mb-4">Links</h2>
        <div class="flex flex-wrap gap-3">
          {post.data.links.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm">
              {link.label} ↗
            </a>
          ))}
        </div>
      </section>
    )}

    {relatedPosts.length > 0 && (
      <section class="mt-14">
        <h2 class="eyebrow mb-4">Related posts</h2>
        <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {relatedPosts.map((related) => (
            <li>
              <a
                href={`/blog/${related.data.slug ?? slugify(related.data.title)}`}
                class="card card-hover group flex flex-col gap-1 p-4"
              >
                <span class="font-semibold text-ink transition-colors group-hover:text-accent">{related.data.title}</span>
                <span class="font-Mono text-xs text-ink-muted">{formatDate(related.data.publishedAt)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {relatedProjects.length > 0 && (
      <section class="mt-14">
        <h2 class="eyebrow mb-4">Related projects</h2>
        <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {relatedProjects.map((project) => (
            <li>
              <a href="/projects" class="card card-hover group flex flex-col gap-1 p-4">
                <span class="font-semibold text-ink transition-colors group-hover:text-accent">{project.data.title}</span>
                <span class="font-Mono text-xs text-ink-muted">View on projects page</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Layout>
