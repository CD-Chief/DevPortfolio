---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | Chief-Daniel Osei" description="This page does not exist." noindex>
	<section class="mx-auto flex min-h-[50vh] max-w-3xl flex-col items-start justify-center gap-6 px-4 py-20 sm:px-8">
		<p class="eyebrow">404</p>
		<h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">That page doesn't exist.</h1>
		<p class="text-lg text-ink-muted">It may have moved, or the link is wrong.</p>
		<div class="flex flex-wrap gap-3">
			<a href="/" class="btn btn-primary">Back home</a>
			<a href="/projects" class="btn btn-ghost">See my projects</a>
		</div>
	</section>
</Layout>
