---
interface Props {
	eyebrow: string;
	title: string;
	href?: string;
	linkLabel?: string;
	as?: 'h1' | 'h2';
}

const { eyebrow, title, href, linkLabel, as: Heading = 'h2' } = Astro.props;
---

<div class="mb-10 flex flex-wrap items-end justify-between gap-4">
	<div class="flex flex-col gap-3">
		<p class="eyebrow">{eyebrow}</p>
		<Heading class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{title}</Heading>
		<slot />
	</div>
	{href && linkLabel && <a href={href} class="link-arrow">{linkLabel} →</a>}
</div>
