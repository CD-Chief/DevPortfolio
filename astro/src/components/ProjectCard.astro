---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TagList from './TagList.astro';
import type { TechName } from '../data/tech';

interface Props {
  name: string;
  image?: ImageMetadata;
  technologies: TechName[];
  description: string;
  showMoreButton?: boolean;
  link?: string;
  projectId?: number;
  year?: string;
  // Smaller card without a screenshot, used for the "Earlier work" section
  compact?: boolean;
}

const { name, image, technologies, description, showMoreButton = false, link = '#', projectId, year, compact = false } = Astro.props;
const hasLink = link && link !== '#';
---

<article class="card card-hover group flex h-full flex-col overflow-hidden">
  {image && !compact && (
    <div class="aspect-[16/10] overflow-hidden border-b border-line bg-panel-raised p-3">
      <Image
        src={image}
        alt={`Screenshot of ${name}`}
        width={640}
        height={400}
        class="h-full w-full rounded-lg object-contain transition-transform duration-500 group-hover:scale-[1.02] motion-reduce:transition-none"
        loading="lazy"
      />
    </div>
  )}

  <div class:list={['flex flex-1 flex-col', compact ? 'gap-3 p-5' : 'gap-4 p-6']}>
    {year && <p class="font-Mono text-xs text-ink-muted">{year}</p>}
    <h3 class:list={['font-semibold text-ink', compact ? 'text-lg' : 'text-xl']}>{name}</h3>
    <p class="text-sm leading-relaxed text-ink-muted">{description}</p>

    <TagList tags={technologies} max={compact ? 3 : 4} class="mt-auto pt-2" />

    {(showMoreButton && projectId) || hasLink ? (
      <div class="flex flex-wrap items-center gap-4 pt-2">
        {showMoreButton && projectId && (
          <button
            type="button"
            data-project-id={projectId}
            data-project-title={name}
            data-umami-event="project-open"
            data-umami-event-item={name}
            class="project-modal-trigger btn btn-ghost btn-sm"
          >
            Read more
          </button>
        )}
        {hasLink && (
          <a href={link} target="_blank" rel="noopener noreferrer" class="link-arrow" data-umami-event="project-link" data-umami-event-item={name}>
            View live ↗
          </a>
        )}
      </div>
    ) : null}
  </div>
</article>
