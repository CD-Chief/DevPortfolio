---
import { getCollection } from 'astro:content';
import PostCard from './PostCard.astro';
import SectionHeader from './SectionHeader.astro';
import { slugify } from '../utils/slug';

const POST_SLOTS = 3;

const allPosts = await getCollection('posts');

const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);

const latestPosts = sortedPosts.slice(0, POST_SLOTS);
// Keep the grid even until there are enough posts to fill it
const emptySlots = Math.max(0, POST_SLOTS - latestPosts.length);
---

<section id="blog" class="mx-auto max-w-7xl scroll-mt-8 px-4 py-20 sm:px-8">
  <SectionHeader eyebrow="Blog" title="Notes from running my own infrastructure" href="/blog" linkLabel="All posts" />

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {latestPosts.map((post) => (
      <PostCard
        title={post.data.title}
        slug={post.data.slug ?? slugify(post.data.title)}
        coverImage={post.data.coverImage}
        topic={post.data.topic}
        tech={post.data.tech}
        excerpt={post.data.excerpt}
        publishedAt={post.data.publishedAt}
      />
    ))}
    {Array.from({ length: emptySlots }, () => (
      <div class="hidden flex-col items-center justify-center gap-2 rounded-2xl border border-dashed border-line p-8 text-center lg:flex">
        <p class="eyebrow text-ink-muted">Up next</p>
        <p class="text-sm text-ink-muted">More writing on the way.</p>
      </div>
    ))}
  </div>
</section>
