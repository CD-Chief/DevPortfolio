---
import Chart from './home/Chart.astro';
import Toolbox from './home/Toolbox.astro';
import Socials from './Socials.astro';
---

<section class="hero" data-live-stats data-state="loading">
	<div class="hero__blob hero__blob--a" aria-hidden="true"></div>
	<div class="hero__blob hero__blob--b" aria-hidden="true"></div>
	<div class="hero__blob hero__blob--c" aria-hidden="true"></div>
	<div class="hero__grain" aria-hidden="true"></div>

	<div class="layout">
		<div class="status" style="grid-area: status">
			<span><span class="live">Live</span> from the VPS running this site</span>
			<span class="updated" data-field="updated" aria-live="polite"></span>
		</div>

		<!-- Row 1: two small, one long -->
		<article class="tile" style="grid-area: cpu">
			<header><h2>CPU</h2><span class="value" data-field="cpu">–</span></header>
			<Chart name="cpu" label="CPU usage" area />
		</article>

		<article class="tile" style="grid-area: mem">
			<header><h2>Memory</h2></header>
			<div class="mem-ring-wrap">
				<svg class="mem-ring" viewBox="0 0 100 100" aria-hidden="true">
					<circle class="mem-ring-track" cx="50" cy="50" r="42" pathLength="100" />
					<circle class="mem-ring-fill" cx="50" cy="50" r="42" pathLength="100" data-field="mem-ring" />
				</svg>
				<div class="mem-ring-label">
					<span class="mem-ring-value" data-field="mem">–</span>
					<span class="sub" data-field="mem-detail"></span>
				</div>
			</div>
		</article>

		<article class="tile" style="grid-area: net">
			<header>
				<h2>Top containers <span class="h2-sub">by memory</span></h2>
				<span class="netline" aria-label="Network">
					<span>↓ <b data-field="net-in">–</b></span>
					<span>↑ <b data-field="net-out">–</b></span>
					<span class="muted" data-field="net-24h"></span>
				</span>
			</header>
			<ul class="clist" data-field="top-containers" aria-label="Memory used by container group"></ul>
		</article>

		<!-- Row 2: intro + toolbox -->
		<div class="intro" style="grid-area: intro">
			<p class="eyebrow">Chief-Daniel Osei</p>
			<h1>I build and run the infrastructure behind real websites.</h1>
			<p class="lede">
				CS graduate from Newcastle and founder of Chief Studios. I ship client sites with reproducible
				environments, CI/CD and monitoring, and the server running this page is the one shown here. Based in
				Duisburg, looking for DevOps and cloud roles in Germany from spring 2027.
			</p>

			<div class="cta-row">
				<a href="#projects" class="btn btn-primary" data-umami-event="cta-click" data-umami-event-place="hero-projects">See my projects</a>
				<a href="mailto:chief.d.osei@gmail.com" class="btn btn-ghost" data-umami-event="contact-click" data-umami-event-channel="email" data-umami-event-place="hero">Get in touch</a>
				<span class="divider" aria-hidden="true"></span>
				<Socials place="hero" />
			</div>
		</div>

		<div class="toolbox-wrap" style="grid-area: toolbox">
			<Toolbox />
		</div>

		<!-- Row 3: one long, two small -->
		<article class="tile" style="grid-area: load">
			<header>
				<h2>Load average</h2>
				<span class="legend">
					<span class="key s1">1m <b data-field="load-1">–</b></span>
					<span class="key s2">5m <b data-field="load-5">–</b></span>
					<span class="key s3">15m <b data-field="load-15">–</b></span>
				</span>
			</header>
			<Chart name="load" label="Load average over 1, 5 and 15 minutes" series={3} />
		</article>

		<article class="tile tile--plain" style="grid-area: up">
			<header><h2>Uptime</h2></header>
			<p class="big" data-field="uptime">–</p>
			<p class="sub" data-field="uptime-since"></p>
		</article>

		<article class="tile tile--plain" style="grid-area: ctr">
			<header><h2>Containers</h2></header>
			<p class="big"><span data-field="containers">–</span> <small>running</small></p>
			<p class="sub" data-field="containers-health"></p>
			<div class="cdots" data-field="container-dots" aria-hidden="true"></div>
		</article>
	</div>
</section>

<script>
	import { initLiveStats } from '../scripts/live-stats';

	const root = document.querySelector<HTMLElement>('[data-live-stats]');
	if (root) initLiveStats(root);
</script>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background: var(--color-night);
		color: var(--color-ink);
		font-family: var(--font-Display2);
	}

	/* Drifting colour fields behind everything */
	.hero__blob {
		position: absolute;
		inset: -30%;
		z-index: -2;
		will-change: transform;
		pointer-events: none;
	}

	.hero__blob--a {
		background: radial-gradient(circle at 30% 35%, rgba(92, 200, 232, 0.28) 0%, rgba(92, 200, 232, 0.1) 35%, rgba(92, 200, 232, 0) 65%);
		animation: drift-a 28s ease-in-out infinite alternate;
	}

	.hero__blob--b {
		background: radial-gradient(circle at 72% 68%, rgba(110, 123, 242, 0.24) 0%, rgba(110, 123, 242, 0.08) 38%, rgba(110, 123, 242, 0) 68%);
		animation: drift-b 36s ease-in-out infinite alternate;
	}

	.hero__blob--c {
		background: radial-gradient(circle at 55% 15%, rgba(6, 22, 79, 0.85) 0%, rgba(6, 22, 79, 0.35) 40%, rgba(6, 22, 79, 0) 72%);
		animation: drift-c 44s ease-in-out infinite alternate;
	}

	.hero__grain {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		opacity: 0.15;
		mix-blend-mode: soft-light;
		background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
		background-size: 120px 120px;
	}

	/* Fade the colour fields out so the hero blends into the page below */
	.hero::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 140px;
		z-index: -1;
		pointer-events: none;
		background: linear-gradient(to bottom, transparent, var(--color-night));
	}

	@keyframes drift-a {
		from { transform: translate3d(-4%, -2%, 0) scale(1); }
		to { transform: translate3d(5%, 4%, 0) scale(1.12); }
	}

	@keyframes drift-b {
		from { transform: translate3d(3%, 4%, 0) scale(1.08); }
		to { transform: translate3d(-5%, -3%, 0) scale(1); }
	}

	@keyframes drift-c {
		from { transform: translate3d(2%, -3%, 0) scale(1); }
		to { transform: translate3d(-3%, 3%, 0) scale(1.1); }
	}

	/* Mobile first: intro on top, widgets below in two columns */
	.layout {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-template-areas:
			'intro intro'
			'toolbox toolbox'
			'status status'
			'cpu mem'
			'net net'
			'load load'
			'up ctr';
		gap: 12px;
		max-width: 1280px;
		margin: 0 auto;
		padding: 40px 16px 48px;
	}

	@media (min-width: 1024px) {
		.layout {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			grid-template-rows: auto 176px auto 176px;
			grid-template-areas:
				'status status status status'
				'cpu mem net net'
				'intro intro intro toolbox'
				'load load up ctr';
			gap: 16px;
			padding: 24px 32px 40px;
		}
	}

	/* No data at all: drop the widgets and let the intro stand alone */
	.hero[data-state='offline'] .tile,
	.hero[data-state='offline'] .status {
		display: none;
	}

	.status {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 10px;
		padding-top: 8px;
		font: 500 12px/1 var(--font-Mono);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-ink-muted);
	}

	.updated {
		margin-left: auto;
		letter-spacing: 0.04em;
		text-transform: none;
	}

	/* A bright band sweeps across "LIVE" every few seconds */
	.live {
		font-weight: 700;
		color: transparent;
		background: linear-gradient(90deg, var(--color-accent) 0 40%, #ffffff 50%, var(--color-accent) 60% 100%);
		background-size: 300% 100%;
		background-position: 100% 0;
		-webkit-background-clip: text;
		background-clip: text;
		animation: live-sweep 5s ease-in-out infinite;
	}

	.hero[data-state='stale'] .live {
		background: none;
		color: var(--color-ink-muted);
		animation: none;
		filter: none;
	}

	@keyframes live-sweep {
		0% { background-position: 100% 0; filter: drop-shadow(0 0 0 rgba(92, 200, 232, 0)); }
		15% { filter: drop-shadow(0 0 6px rgba(92, 200, 232, 0.8)); }
		30%, 100% { background-position: 0 0; filter: drop-shadow(0 0 0 rgba(92, 200, 232, 0)); }
	}

	/* Widgets */
	.tile {
		display: flex;
		flex-direction: column;
		gap: 12px;
		min-width: 0;
		min-height: 150px;
		padding: 16px 18px;
		border-radius: 16px;
		background: color-mix(in srgb, var(--color-panel) 78%, transparent);
		border: 1px solid var(--color-line);
		transition: opacity 300ms;
	}

	.hero[data-state='loading'] .tile {
		opacity: 0.6;
	}

	.tile header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 8px;
	}

	.tile h2 {
		margin: 0;
		font: 500 12px/1 var(--font-Mono);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-ink-muted);
	}

	.value {
		font: 600 18px/1 var(--font-Mono);
		color: var(--color-ink);
	}

	.value small,
	.big small {
		font-size: 12px;
		font-weight: 500;
		color: var(--color-ink-muted);
	}

	.tile :global(.chart) {
		flex: 1;
	}

	.sub {
		margin: 0;
		font: 500 12px/1 var(--font-Mono);
		color: var(--color-ink-muted);
	}

	.big {
		margin: auto 0 0;
		font: 600 clamp(28px, 3vw, 40px)/1 var(--font-Mono);
		color: var(--color-ink);
	}

	.legend {
		display: flex;
		align-items: baseline;
		gap: 14px;
		font: 500 12px/1 var(--font-Mono);
		color: var(--color-ink-muted);
	}

	.legend b {
		color: var(--color-ink);
		font-size: 15px;
	}

	.key::before {
		content: '';
		display: inline-block;
		width: 14px;
		margin-right: 6px;
		vertical-align: middle;
		border-top: 2px solid var(--color-accent);
	}

	.key.s2::before {
		border-top: 2px dashed var(--color-accent-2);
	}

	.key.s3::before {
		border-top: 2px dotted var(--color-accent-3);
	}

	.cdots {
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
	}

	/* One square per container: healthy, unhealthy, or no healthcheck */
	.cdots :global(.cdot) {
		width: 8px;
		height: 8px;
		border-radius: 2px;
		background: var(--color-line);
	}

	.cdots :global(.cdot--ok) {
		background: var(--color-accent);
	}

	.cdots :global(.cdot--bad) {
		background: #f87171;
	}

	/* Memory ring */
	.mem-ring-wrap {
		display: flex;
		flex: 1;
		align-items: center;
		gap: 16px;
	}

	.mem-ring {
		width: 92px;
		height: 92px;
		flex-shrink: 0;
		transform: rotate(-90deg);
	}

	.mem-ring circle {
		fill: none;
		stroke-width: 9;
	}

	.mem-ring-track {
		stroke: var(--color-line);
	}

	.mem-ring-fill {
		stroke: var(--color-accent-2);
		stroke-linecap: round;
		stroke-dasharray: 0 100;
		transition: stroke-dasharray 900ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* A zero-length arc with round caps draws a dot; hide it until data arrives */
	.hero[data-state='loading'] .mem-ring-fill {
		opacity: 0;
	}

	.mem-ring-label {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.mem-ring-value {
		font: 600 clamp(26px, 2.6vw, 34px)/1 var(--font-Mono);
		color: var(--color-ink);
	}

	/* Top containers */
	.h2-sub {
		margin-left: 6px;
		letter-spacing: 0.04em;
		text-transform: none;
		opacity: 0.7;
	}

	.netline {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 4px 12px;
		font: 500 12px/1 var(--font-Mono);
		color: var(--color-ink-muted);
	}

	.netline b {
		color: var(--color-ink);
		font-weight: 600;
	}

	.clist {
		display: grid;
		grid-template-columns: 1fr;
		gap: 9px 28px;
		margin: auto 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 640px) {
		.clist {
			grid-template-columns: 1fr 1fr;
			grid-auto-flow: column;
			grid-template-rows: repeat(3, auto);
		}
	}

	.clist :global(.crow) {
		display: grid;
		grid-template-columns: 7.5rem 1fr 4rem;
		align-items: center;
		gap: 10px;
		font: 500 12px/1.2 var(--font-Mono);
	}

	.clist :global(.cname) {
		overflow: hidden;
		color: var(--color-ink);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.clist :global(.cname small) {
		color: var(--color-ink-muted);
	}

	.clist :global(.cbar) {
		height: 6px;
		border-radius: 3px;
		background: color-mix(in srgb, var(--color-line) 70%, transparent);
		overflow: hidden;
	}

	.clist :global(.cbar i) {
		display: block;
		height: 100%;
		border-radius: 3px;
		background: var(--color-accent);
		transition: width 700ms ease;
	}

	.clist :global(.crow--other .cbar i) {
		background: var(--color-ink-muted);
	}

	.clist :global(.cval) {
		color: var(--color-ink-muted);
		text-align: right;
	}

	/* Intro */
	.intro {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 18px;
		padding: 8px 0 16px;
	}

	@media (min-width: 1024px) {
		.intro {
			padding: 12px 48px 12px 4px;
		}
	}

	.eyebrow {
		margin: 0;
		font: 600 clamp(18px, 1.8vw, 24px)/1.1 var(--font-Mono);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	h1 {
		margin: 0;
		font-weight: 600;
		font-size: clamp(2rem, 3.8vw, 3.2rem);
		line-height: 1.08;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.lede {
		margin: 0;
		max-width: 62ch;
		font-size: clamp(1rem, 1.3vw, 1.15rem);
		line-height: 1.6;
		color: var(--color-ink-muted);
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
		margin-top: 4px;
	}

	.divider {
		width: 1px;
		height: 28px;
		margin: 0 4px;
		background: var(--color-line);
	}

	/* On narrow screens the icons wrap to their own line, so the divider would dangle */
	@media (max-width: 479px) {
		.divider {
			display: none;
		}
	}

	.toolbox-wrap {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	@media (prefers-reduced-motion: reduce) {
		.mem-ring-fill,
		.clist :global(.cbar i) {
			transition: none;
		}

		.hero__blob,
		.live {
			animation: none;
		}

	}
</style>
