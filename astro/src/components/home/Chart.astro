---
// Empty chart frame; live-stats.ts draws the SVG paths into it once data arrives
interface Props {
	name: string;
	label: string;
	series?: number;
	area?: boolean;
}

const { name, label, series = 1, area = false } = Astro.props;
---

<div class="chart" data-chart={name} data-label={label} data-area={area ? '' : undefined} role="img" aria-label={label}>
	<svg viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true"></svg>
	<div class="crosshair" aria-hidden="true"></div>
	{Array.from({ length: series }, (_, i) => <div class={`dot s${i + 1}`} aria-hidden="true"></div>)}
	<div class="tip" aria-hidden="true"></div>
</div>

<style>
	.chart {
		position: relative;
		width: 100%;
		height: 100%;
		min-height: 56px;
		touch-action: pan-y;
	}

	svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		/* faint baseline so an empty chart still reads as a chart */
		border-bottom: 1px solid var(--color-line);
	}

	.chart :global(.line) {
		fill: none;
		stroke-width: 2;
		stroke-linejoin: round;
		stroke-linecap: round;
	}

	.chart :global(.line.s1) {
		stroke: var(--color-accent);
	}

	.chart :global(.line.s2) {
		stroke: var(--color-accent-2);
	}

	.chart :global(.line.dashed) {
		stroke-dasharray: 4 3;
	}

	.chart :global(.area.s1) {
		fill: color-mix(in srgb, var(--color-accent) 18%, transparent);
	}

	.chart :global(.area.s2) {
		fill: color-mix(in srgb, var(--color-accent-2) 20%, transparent);
	}

	.crosshair,
	.dot,
	.tip {
		position: absolute;
		pointer-events: none;
		opacity: 0;
		transition: opacity 120ms;
	}

	.crosshair {
		top: 0;
		bottom: 0;
		width: 1px;
		background: var(--color-ink-muted);
		opacity: 0;
	}

	.dot {
		width: 8px;
		height: 8px;
		margin: -4px 0 0 -4px;
		border-radius: 50%;
		/* 2px surface ring so the dot separates from the line */
		box-shadow: 0 0 0 2px var(--color-panel);
	}

	.dot.s1 {
		background: var(--color-accent);
	}

	.dot.s2 {
		background: var(--color-accent-2);
	}

	.tip {
		top: -30px;
		padding: 3px 8px;
		border-radius: 6px;
		background: var(--color-panel-raised);
		border: 1px solid var(--color-line);
		color: var(--color-ink);
		font: 500 11px/1.4 var(--font-Mono);
		white-space: nowrap;
	}

	.chart:global(.hovering) .crosshair {
		opacity: 0.5;
	}

	.chart:global(.hovering) .dot,
	.chart:global(.hovering) .tip {
		opacity: 1;
	}
</style>
