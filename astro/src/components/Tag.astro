---
import { isInfra, type TechName } from '../data/tech';

interface Props {
  label: TechName;
}

const { label } = Astro.props;
---

<span
  class:list={[
    'rounded-md border px-2 py-1 font-Mono text-[11px] leading-none',
    isInfra(label)
      ? 'border-accent/30 bg-accent/10 text-accent'
      : 'border-line bg-panel-raised/60 text-ink-muted',
  ]}
>
  {label}
</span>
