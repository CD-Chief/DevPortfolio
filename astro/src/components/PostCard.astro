---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  slug: string;
  coverImage?: ImageMetadata;
  tags: string[];
  excerpt: string;
  publishedAt: string;
}

const { title, slug, coverImage, tags, excerpt, publishedAt } = Astro.props;

const getTagColor = (tag: string) => {
  const tagLower = tag.toLowerCase();

  if (tagLower.includes('css') || tagLower.includes('tailwind') || tagLower.includes('sass') ||
      tagLower.includes('figma')) {
    return 'bg-pink-100 text-pink-700 border-pink-300';
  }

  if (tagLower.includes('node') || tagLower.includes('express') || tagLower.includes('python') ||
      tagLower.includes('flask') || tagLower.includes('next') || tagLower.includes('sanity')) {
    return 'bg-green-100 text-green-700 border-green-300';
  }

  if (tagLower.includes('mongo') || tagLower.includes('sql') || tagLower.includes('database')) {
    return 'bg-purple-100 text-purple-700 border-purple-300';
  }

  if (tagLower.includes('raspberry') || tagLower.includes('pi')) {
    return 'bg-red-100 text-red-700 border-red-300';
  }

  if (tagLower.includes('pytorch') || tagLower.includes('mediapipe') || tagLower.includes('gemini') ||
      tagLower.includes('api')) {
    return 'bg-indigo-100 text-indigo-700 border-indigo-300';
  }

  if (tagLower.includes('html') || tagLower.includes('javascript') || tagLower.includes('typescript') ||
      tagLower.includes('react') || tagLower.includes('vue') || tagLower.includes('angular') ||
      tagLower.includes('astro')) {
    return 'bg-blue-100 text-blue-700 border-blue-300';
  }

  if (tagLower.includes('docker') || tagLower.includes('traefik') || tagLower.includes('github actions') ||
      tagLower.includes('azure') || tagLower.includes('aws') || tagLower.includes('gcp') ||
      tagLower.includes('kubernetes') || tagLower.includes('ci/cd')) {
    return 'bg-orange-100 text-orange-700 border-orange-300';
  }

  return 'bg-gray-100 text-gray-700 border-gray-300';
};
---

<article class="bg-white shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300 border border-gray-200 w-full">
  <div class="flex items-center justify-between p-4">
    <h3 class="text-xl font-Display1 text-Neutral-Dark flex-1 text-center">{title}</h3>
  </div>

  <div class={`grid gap-6 p-6 ${coverImage ? 'grid-cols-1 md:grid-cols-2' : 'grid-cols-1'}`}>
    {coverImage && (
      <div class="flex items-center justify-center">
        <Image
          src={coverImage}
          alt={title}
          width={320}
          height={200}
          class="w-full h-48 object-contain"
          loading="lazy"
        />
      </div>
    )}

    <div class={`flex flex-col gap-4 ${!coverImage ? 'items-center text-center' : ''}`}>
      <div>
        <h4 class="text-sm font-semibold text-gray-600 mb-2">Tags</h4>
        <div class="flex flex-wrap gap-2 justify-center">
          {tags.map((tag) => (
            <span class={`px-3 py-1 rounded-full text-xs font-medium border ${getTagColor(tag)}`}>
              {tag}
            </span>
          ))}
        </div>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-gray-600 mb-2">Excerpt</h4>
        <p class="text-sm text-gray-700 leading-relaxed">
          {excerpt}
        </p>
      </div>

      <div class="text-xs text-gray-500">
        Published {publishedAt}
      </div>
    </div>
  </div>

  <div class="px-6 pb-6 flex justify-center">
    <a
      href={`/blog/${slug}`}
      class="inline-block text-Neutral-Dark font-medium text-sm px-4 py-2 relative transition-all duration-200 hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[4px_4px_0px_0px_rgba(26,25,49,1)] cursor-pointer border-2 border-Neutral-Dark bg-white"
    >
      Read Post →
    </a>
  </div>
</article>
