---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tag from './Tag.astro';

interface Props {
  title: string;
  slug: string;
  coverImage?: ImageMetadata;
  tags: string[];
  excerpt: string;
  publishedAt: string;
}

const { title, slug, coverImage, tags, excerpt, publishedAt } = Astro.props;

---

<article class="bg-white shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300 border border-gray-200 w-full">
  <div class="flex items-center justify-between p-4">
    <h3 class="text-xl font-Display1 text-Neutral-Dark flex-1 text-center">{title}</h3>
  </div>

  <div class={`grid gap-6 p-6 ${coverImage ? 'grid-cols-1 md:grid-cols-2' : 'grid-cols-1'}`}>
    {coverImage && (
      <div class="flex items-center justify-center">
        <Image
          src={coverImage}
          alt={title}
          width={320}
          height={200}
          class="w-full h-48 object-contain"
          loading="lazy"
        />
      </div>
    )}

    <div class={`flex flex-col gap-4 ${!coverImage ? 'items-center text-center' : ''}`}>
      <div>
        <h4 class="text-sm font-semibold text-gray-600 mb-2">Tags</h4>
        <div class="flex flex-wrap gap-2 justify-center">
          {tags.map((tag) => (
            <Tag label={tag} />
          ))}
        </div>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-gray-600 mb-2">Excerpt</h4>
        <p class="text-sm text-gray-700 leading-relaxed">
          {excerpt}
        </p>
      </div>

      <div class="text-xs text-gray-500">
        Published {publishedAt}
      </div>
    </div>
  </div>

  <div class="px-6 pb-6 flex justify-center">
    <a
      href={`/blog/${slug}`}
      class="inline-block text-Neutral-Dark font-medium text-sm px-4 py-2 relative transition-all duration-200 hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[4px_4px_0px_0px_rgba(26,25,49,1)] cursor-pointer border-2 border-Neutral-Dark bg-white"
    >
      Read Post →
    </a>
  </div>
</article>
