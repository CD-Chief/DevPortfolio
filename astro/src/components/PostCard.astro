---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TagList from './TagList.astro';
import type { TechName, Topic } from '../data/tech';
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  slug: string;
  coverImage?: ImageMetadata;
  topic: Topic;
  tech: TechName[];
  excerpt: string;
  publishedAt: string;
}

const { title, slug, coverImage, topic, tech, excerpt, publishedAt } = Astro.props;
---

<article class="card card-hover group h-full overflow-hidden">
  <a href={`/blog/${slug}`} class="flex h-full flex-col">
    {coverImage && (
      <div class:list={['aspect-[16/9] overflow-hidden border-b border-line', coverImage.format === 'svg' ? 'cover-svg p-6' : 'bg-panel-raised']}>
        <Image
          src={coverImage}
          alt=""
          width={640}
          height={360}
          class:list={['h-full w-full transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none', coverImage.format === 'svg' ? 'object-contain' : 'object-cover']}
          loading="lazy"
        />
      </div>
    )}

    <div class="flex flex-1 flex-col gap-3 p-6">
      <p class="flex items-center gap-2 font-Mono text-xs">
        <span class="font-semibold uppercase tracking-widest text-accent">{topic}</span>
        <span class="text-ink-muted" aria-hidden="true">·</span>
        <time datetime={publishedAt} class="text-ink-muted">{formatDate(publishedAt)}</time>
      </p>
      <h3 class="text-lg font-semibold leading-snug text-ink transition-colors group-hover:text-accent">{title}</h3>
      <p class="line-clamp-3 text-sm leading-relaxed text-ink-muted">{excerpt}</p>
      <TagList tags={tech} max={4} class="mt-auto pt-2" />
    </div>
  </a>
</article>
