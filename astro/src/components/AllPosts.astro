---
import { getCollection } from 'astro:content';
import PostCard from './PostCard.astro';
import SectionHeader from './SectionHeader.astro';
import { slugify } from '../utils/slug';

const allPosts = await getCollection('posts');

const posts = allPosts.sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);
---

<section class="mx-auto max-w-7xl px-4 pb-10 pt-8 sm:px-8">
  <SectionHeader as="h1" eyebrow="Blog" title="All posts">
    <p class="max-w-2xl text-ink-muted">Write-ups on self-hosting, CI/CD and the things that broke along the way.</p>
  </SectionHeader>

  <label for="postFilter" class="sr-only">Filter posts</label>
  <input
    type="search"
    id="postFilter"
    placeholder="Filter by title, topic or technology"
    class="field mb-10 max-w-md"
  />

  <div id="postsGrid" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => {
      const slug = post.data.slug ?? slugify(post.data.title);
      const searchIndex = [post.data.title, post.data.excerpt, post.data.topic, post.data.tech.join(' ')].join(' ');

      return (
        <div class="post-card" data-search={searchIndex.toLowerCase()}>
          <PostCard
            title={post.data.title}
            slug={slug}
            coverImage={post.data.coverImage}
            topic={post.data.topic}
            tech={post.data.tech}
            excerpt={post.data.excerpt}
            publishedAt={post.data.publishedAt}
          />
        </div>
      );
    })}
  </div>
  <p id="postsEmpty" class="hidden py-12 text-center text-ink-muted">No posts match that.</p>
</section>

<script>
  const filterInput = document.getElementById('postFilter') as HTMLInputElement;
  const postsGrid = document.getElementById('postsGrid');

  if (filterInput && postsGrid) {
    filterInput.addEventListener('input', (e) => {
      const filterValue = (e.target as HTMLInputElement).value.toLowerCase().trim();
      const postCards = postsGrid.querySelectorAll('[data-search]');

      let shown = 0;
      postCards.forEach((card) => {
        const searchText = card.getAttribute('data-search') || '';
        const match = filterValue === '' || searchText.includes(filterValue);
        card.classList.toggle('hidden', !match);
        if (match) shown++;
      });
      document.getElementById('postsEmpty')?.classList.toggle('hidden', shown > 0);
    });
  }
</script>
