# Copy to .env (docker compose) and/or astro/.env (astro dev). Never commit real values.

# Beszel hub that monitors this server. Use a dedicated user with the "readonly" role,
# assigned only to the system below. Leave these unset to hide the live stats panel.
BESZEL_URL=https://beszel.example.com
BESZEL_EMAIL=portfolio-readonly@example.com
BESZEL_PASSWORD=change-me
# System name exactly as shown in the Beszel dashboard
BESZEL_SYSTEM=my-vps
